# Copy to .env.local and fill in. Server-side only; never commit the real file.
# Any OpenAI-compatible chat-completions endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# optional: comma-separated fallbacks tried when the primary model is rate-limited or slow
LLM_FALLBACK_MODELS=

# Optional (07 Option B, not used by the default deployment):
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
